# ============================================================
#  Proyecto Novedades — Variables de Entorno
#  Copia este archivo como .env y completa los valores reales.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development        # development | production

# --- Base de Datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_novedades
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui

# --- Autenticación JWT ---
JWT_SECRET=clave_secreta_minimo_32_caracteres_aqui
JWT_EXPIRES_IN=8h           # Ejemplos: 1h, 8h, 1d

# --- CORS (Orígenes permitidos) ---
CORS_ORIGIN_DEV=http://localhost:4200
CORS_ORIGIN_PROD=https://tudominio.edu.co

