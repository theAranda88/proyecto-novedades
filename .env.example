# ============================================================
#  Proyecto Novedades — Variables de Entorno
#  Copia este archivo como .env y completa los valores reales.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development        # development | production

# --- Base de Datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_novedades
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui

# --- Autenticación JWT ---
JWT_SECRET=clave_secreta_minimo_32_caracteres_aqui
JWT_EXPIRES_IN=8h           # Ejemplos: 1h, 8h, 1d

# --- Seguridad bcrypt (HU_DB §CA-07) ---
BCRYPT_COST=12              # Mínimo requerido por HU_DB

# --- CORS (Orígenes permitidos) ---
CORS_ORIGIN_DEV=http://localhost:4200
CORS_ORIGIN_PROD=https://tudominio.edu.co

# --- Login con Google (Workspace institucional) ---
# Client ID tipo "Aplicación web" en Google Cloud Console (OAuth 2.0).
# No pegar el Client Secret en el frontend. El backend solo verifica el ID token.
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_DOMINIO_PERMITIDO=uniautonoma.edu.co

