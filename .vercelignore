# Vercel — Ignorar archivos que no son necesarios para el build

# Control de versiones
.git
.gitignore
.github

# IDE & Editor
.idea/
.vscode/

# Archivos de documentación (no necesarios en build)
*.md
CAMBIOS_REALIZADOS.md
DEPLOYMENT_GUIDE.md

# Scripts (no se ejecutan en Vercel)
scripts/

# Migraciones y datos (no se necesitan en Vercel)
migrations/
uploads/
postman/
*.sql

# Logs y temporales
*.log
.DS_Store
.env.development.local
.env.test.local
.env.production.local

# Documentación (no afecta el runtime)
*.md
README.md
DEPLOYMENT_GUIDE.md
ANALISIS_MIGRACIONES.md
VALIDACION_MIGRACIONES.md
INFORME_RAILWAY_ACTUAL.md
SOLUCION_ERROR_BUILD.md

# Testing (no necesarios en prod)
*.test.ts
*.spec.ts
__tests__/
coverage/

# Scripts locales (ejecutados en local, no en prod)
postman/

# Archivos temporales
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# NO EXCLUIR (necesarios):
# - dist/          ← Código compilado
# - migrations/    ← Scripts SQL
# - scripts/       ← runMigrations.js (ejecutado en build)
# - node_modules/  ← Vercel lo maneja con npm install

# Vercel config
.vercel
.vercelignore



