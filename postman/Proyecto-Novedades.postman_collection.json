        {
          "name": "POST Cambio de Contrasena — Primer Login (HU_001 CA-03)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Usar el token temporal de primer_login",
                  "const tokenTemporal = pm.collectionVariables.get('token_primer_login');",
                  "if (tokenTemporal) {",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + tokenTemporal });",
                  "    console.log('Usando token temporal de primer_login');",
                  "} else {",
                  "    console.warn('No hay token_primer_login guardado. Ejecuta login primero.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Status 200 - Contrasena cambiada', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve nuevo token con acceso completo', () => {",
                  "    pm.expect(r.datos).to.have.property('token');",
                  "    pm.expect(r.datos.token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "// Guardar el nuevo token con acceso completo",
                  "if (r.datos?.token) {",
                  "    pm.collectionVariables.set('token', r.datos.token);",
                  "    pm.collectionVariables.set('token_primer_login', '');",
                  "    console.log('Nuevo token con acceso completo guardado');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_primer_login}}", "description": "Token temporal del primer login" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password_actual\": \"Password123\",\n  \"password_nueva\": \"NuevaContrasena456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Cambia la contrasena temporal. SOLO disponible cuando primer_login = TRUE.\n\nReglas de la nueva contrasena:\n- Minimo 8 caracteres\n- Al menos 1 numero\n- Al menos 1 letra\n- No puede ser igual a la temporal\n\nAl completar exitosamente devuelve un nuevo JWT con primer_login = FALSE."
          },
