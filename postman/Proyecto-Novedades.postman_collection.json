            },
            {
              "name": "403 — Ya cambio la contrasena",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"ok\": false,\n  \"mensaje\": \"Esta accion solo esta disponible en el primer acceso al sistema\",\n  \"datos\": null,\n  \"codigo_estado\": 403\n}"
            }
